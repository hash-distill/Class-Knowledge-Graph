{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "精析智评",
  "version": "0.1.0",
  "identifier": "org.fourc.workbench",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["desktop-minimal"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "精析智评课堂观察与教学复盘工作台",
    "externalBin": ["binaries/4c-review-backend"],
    "resources": {"../../frontend/dist/": "frontend/"},
    "windows": {"webviewInstallMode": {"type": "skip"}, "nsis": {"installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true}}
  }
}
